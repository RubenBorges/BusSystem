CompileFlags:
  CompilationDatabase: .build/linux-*
  CompilationDatabase: .build/linux-*

  Add:
    - -std=c++26
    - -I/usr/include
    - -I/usr/include/pqxx
    - -I/usr/local/include
    - -fno-implicit-modules
    - -fno-implicit-module-maps
    - -fmodule-file=std=/home/boopy/.cache/clangd-modules/std.pcm
  Remove:
    - -fmodules
    - -fmodule-mapper=*
    - -fmodules-ts
    - -fdeps-format=*
    - -fdeps-file=*
    - -fdeps-target=*
