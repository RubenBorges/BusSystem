CompileFlags:
  # Point clangd to the compile_commands.json generated by your linux-dev preset
  CompilationDatabase: build/linux-dev

  # Ensure clangd parses in C++26 mode even when opening new/unindexed .cppm files
  Add:
    - -std=c++26
    - -fmodules

  # Strip GCC 16-specific module mapper flags that Clang's parser doesn't recognize
  Remove:
    - -fmodule-mapper=*
    - -fmodules-ts
    - -fdeps-format=*
    - -fdeps-file=*
    - -fdeps-target=*

Diagnostics:
  # Suppress false-positive warnings on module partitions or global module fragments
  Suppress:
    - module-not-found
