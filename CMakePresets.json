{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja"
        },
        {
            "name": "linux-dev",
            "inherits": "base",
            "binaryDir": "${sourceDir}/.build/linux-dev",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_STANDARD": "26",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/${sourceDirName}"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "description": "Release build using Ninja in the build directory.",
            "inherits": "base",
            "binaryDir": "${sourceDir}/.build/linux-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "26",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/${sourceDirName}"
            }
        },
        {
            "name": "msvc-wine",
            "displayName": "Windows x64 (msvc-wine)",
            "inherits": "base",
            "binaryDir": "${sourceDir}/.build/msvc-wine",
            "environment": {
                "PATH": "/opt/msvc/bin/x64:$penv{PATH}",
                "CC": "cl",
                "CXX": "cl",
                "RC": "rc"
            },
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Windows",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/${sourceDirName}-win"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "dev-build",
            "configurePreset": "linux-dev"
        },
        {
            "name": "dev-install",
            "configurePreset": "linux-dev",
            "targets": [
                "install"
            ]
        },
        {
            "name": "release-build",
            "configurePreset": "linux-release"
        },
        {
            "name": "release-install",
            "configurePreset": "linux-release",
            "targets": [
                "install"
            ]
        },
        {
            "name": "win-build",
            "configurePreset": "msvc-wine"
        },
        {
            "name": "win-install",
            "configurePreset": "msvc-wine",
            "targets": [
                "install"
            ]
        }
    ],
    "workflowPresets": [
        {
            "name": "dev",
            "steps": [
                {
                    "type": "configure",
                    "name": "linux-dev"
                },
                {
                    "type": "build",
                    "name": "dev-build"
                },
                {
                    "type": "build",
                    "name": "dev-install"
                }
            ]
        },
        {
            "name": "release",
            "steps": [
                {
                    "type": "configure",
                    "name": "linux-release"
                },
                {
                    "type": "build",
                    "name": "release-build"
                },
                {
                    "type": "build",
                    "name": "release-install"
                }
            ]
        },
        {
            "name": "win",
            "steps": [
                {
                    "type": "configure",
                    "name": "msvc-wine"
                },
                {
                    "type": "build",
                    "name": "win-build"
                },
                {
                    "type": "build",
                    "name": "win-install"
                }
            ]
        }
    ]
}
