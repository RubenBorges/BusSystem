{
  "version": 6,
  "configurePresets": [
    {
      "name": "base-dev",
      "displayName": "Development Config",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-build",
      "configurePreset": "base-dev"
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        {
          "type": "configure",
          "name": "base-dev"
        },
        {
          "type": "build",
          "name": "dev-build"
        }
      ]
    }
  ]
}