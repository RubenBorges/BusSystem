                    offer.server_max_window_bits =
                        parse_bits(param.second);
                    if( offer.server_max_window_bits < 8 ||
                        offer.server_max_window_bits > 15)
                    {



                        return;
                    }
                }
                else if(beast::iequals(param.first,
                    "client_max_window_bits"))
