{

  static void do_init()
  {
    instance_.static_ptr_ = instance_.ptr_ = new T;
  }


  ~posix_global_impl()
  {
    delete static_ptr_;
  }

  static ::pthread_once_t init_once_;
  static T* static_ptr_;
  static posix_global_impl instance_;
  T* ptr_;
};

