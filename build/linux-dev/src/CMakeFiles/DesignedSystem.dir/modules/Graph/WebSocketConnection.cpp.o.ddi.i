            o.client_max_window_bits,
                offer.client_max_window_bits);
        s += "; client_max_window_bits=";
        s += to_static_string(
            config.client_max_window_bits);
        break;
    }

    return s;
}

void
pmd_normalize(pmd_offer& offer)
{
    if(offer.accept)
