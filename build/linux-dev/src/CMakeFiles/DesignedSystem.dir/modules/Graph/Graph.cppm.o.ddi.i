class futex_slim_mutex
  : private noncopyable
{
public:
  typedef boost::asio::detail::scoped_lock<futex_slim_mutex> scoped_lock;


  futex_slim_mutex()
    : state_(0)
  {
  }


  ~futex_slim_mutex()
  {
  }


  bool try_lock()
  {
    int expected = 0;
    return state_.compare_exchange_strong(expected, 1,
        std::memory_order_acquire, std::memory_order_relaxed);
  }


  void lock()
  {
    int expected = 0;
    if (state_.compare_exchange_strong(expected, 1,
          std::memory_order_acquire, std::memory_order_relaxed))
      return;
    if (expected != 2)
      expected = state_.exchange(2, std::memory_order_acquire);
    while (expected != 0)
    {
      futex_wait(2);
      expected = state_.exchange(2, std::memory_order_acquire);
    }
  }


  void unlock()
  {
    if (state_.fetch_sub(1, std::memory_order_release) != 1)
    {
      state_.store(0, std::memory_order_release);
      futex_wake();
    }
  }

private:
  friend class conditionally_enabled_mutex<futex_slim_mutex>;


  void futex_wait(int val)
  {
    int result = ::syscall(202, futex_addr(), (0 | 128),
        val, static_cast<const struct timespec*>(0), 0, 0);
    (void)result;

  }


  void futex_wake()
  {
    ::syscall(202, futex_addr(), (1 | 128), 1, 0, 0, 0);
  }

  int* futex_addr()
  {
    return reinterpret_cast<int*>(&state_);
  }




  std::atomic<int> state_;
};

template <>
class conditionally_enabled_mutex<futex_slim_mutex>
  : private noncopyable
{
public:

  class scoped_lock
    : private noncopyable
  {
  public:

    enum adopt_lock_t { adopt_lock };


    scoped_lock(conditionally_enabled_mutex& m, adopt_lock_t)
      : mutex_(m),
        locked_(m.enabled())
    {
    }


    explicit scoped_lock(conditionally_enabled_mutex& m)
      : mutex_(m),
        locked_(false)
    {
      if (m.enabled())
      {
        for (int n = mutex_.spin_count_; n != 0; n -= (n > 0) ? 1 : 0)
        {
          if (mutex_.try_lock())
          {
            locked_ = true;
            return;
          }
        }
        mutex_.lock();
        locked_ = true;
      }
    }


    ~scoped_lock()
    {
      if (locked_)
        mutex_.mutex_.unlock();
    }


    void lock()
    {
      if (!locked_ && mutex_.enabled())
      {
        for (int n = mutex_.spin_count_; n != 0; n -= (n > 0) ? 1 : 0)
        {
          if (mutex_.try_lock())
          {
            locked_ = true;
            return;
          }
        }
        mutex_.mutex_.lock();
        locked_ = true;
      }
    }


    void unlock()
    {
      if (locked_)
      {
        mutex_.mutex_.unlock();
        locked_ = false;
      }
    }


    bool locked() const
    {
      return locked_;
    }

  private:
    friend class conditionally_enabled_mutex;
    conditionally_enabled_mutex& mutex_;
    bool locked_;
  };


  explicit conditionally_enabled_mutex(bool enabled, int spin_count = 0)
    : spin_count_(spin_count)
  {
    if (!enabled)
      mutex_.state_.store(-1, std::memory_order_relaxed);
  }


  ~conditionally_enabled_mutex()
  {
  }


  bool enabled() const
  {
    return mutex_.state_.load(std::memory_order_relaxed) != -1;
  }


  int spin_count() const
  {
    return spin_count_;
  }


  void lock()
  {
    if (enabled())
    {
      for (int n = spin_count_; n != 0; n -= (n > 0) ? 1 : 0)
        if (mutex_.try_lock())
          return;
      mutex_.lock();
    }
  }


  void unlock()
  {
    if (enabled())
      mutex_.unlock();
  }


  bool try_lock()
  {
    if (!enabled())
      return true;
    return mutex_.try_lock();
  }

private:
  friend class scoped_lock;
  futex_slim_mutex mutex_;
  const int spin_count_;
